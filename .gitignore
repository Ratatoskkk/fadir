.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

node_modules/
frontend/dist/
.vite/

.DS_Store
Thumbs.db

# Local Claude Code permissions — personal, not project config.
.claude/settings.local.json
